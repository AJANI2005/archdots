font=0xProto Nerd Font Mono 11
background-color=#1e1e22ee
text-color=#dedede
border-color=#4a4a50
border-size=2
border-radius=10
padding=12,16
margin=8
width=360
height=120
outer-margin=12,16
anchor=top-right
default-timeout=5000
max-visible=5
icons=1
max-icon-size=48
icon-location=left
markup=1
format=<b>%s</b>\n%b
sort=-time

[urgency=low]
background-color=#1e1e22ee
border-color=#4a4a50
default-timeout=3000

[urgency=normal]
background-color=#1e1e22ee
border-color=#4a4a50
default-timeout=8000

[urgency=critical]
background-color=#2a1a1c
border-color=#4a4a50
border-size=3
default-timeout=0
